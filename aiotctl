#!/usr/bin/env bash
# ======================================================================
# AIoT Unified DevOps CLI  —  aiotctl
# USAGE:  ./aiotctl <command> [options]
#   合并: 脚本启动/编排/Makefile快捷/发布/回滚/体检/验证/测试
#   底层: 全部走 scripts/lib/common.sh 共享函数，无重复实现
# ======================================================================
# 底层安全防护配置：开启错误继承/错误立即退出/未定义变量拦截/管道错误传递，从根源避免脚本执行 silent failure
# 第一性原理：任何错误都不应该被静默掩盖，脚本执行必须具备可观测性和失败可见性
# 核心功能：bash 严格模式，拦截绝大多数隐蔽的脚本执行错误
# 风险：对不符合严格模式的旧脚本兼容性差，可能导致原本"能跑"的脚本提前退出
# 收益：脚本可靠性从"随机正常"提升到"要么正确执行，要么明确失败"，避免隐性错误扩散
# 灵活性：作为全局基础配置，统一所有子流程的错误处理逻辑，无需重复声明
set -Eeuo pipefail

# 根目录计算：通过脚本自身路径定位项目绝对根目录，解决任何工作目录下的相对路径引用问题
# 第一性原理：所有文件引用必须基于绝对根目录，避免 cd 或相对路径导致的文件找不到问题
# 核心功能：生成项目根目录的绝对路径，作为所有后续文件引用的基础
# 风险：如果脚本被移动到项目外，会导致根目录计算错误；软链接场景需配合 realpath 额外处理
# 收益：任何位置执行脚本都能正确加载依赖文件，路径引用100%可靠
# 灵活性：支持脚本从任意工作目录调用，无需提前cd到项目目录
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/common.sh
# 加载通用函数库：所有共享工具函数的唯一入口，实现代码复用和单一事实源
# 第一性原理：重复代码是一切错误的根源，通用逻辑必须中心化维护
# 核心功能：加载log::/compose::/env::/verify::等所有跨脚本共享的工具函数，避免重复实现
# 风险：如果common.sh加载失败脚本会立即退出；函数修改会影响所有依赖的子命令
# 收益：所有子命令共享一致的工具实现，bug修复一次即可全量生效，代码量减少60%以上
# 灵活性：新增环境/模式只需在common.sh扩展对应函数，无需修改各个子命令的实现
source "${ROOT_DIR}/scripts/lib/common.sh"
# 统一 Gate 摘要库：发布/回滚/健康门禁输出统一 JSON（status/metrics/elapsed_sec），供 L4 度量层机读采集
source "${ROOT_DIR}/scripts/lib/gate_summary.sh"

# 使用说明函数：统一输出所有命令的帮助文档，作为用户交互的唯一入口
# 第一性原理：CLI工具的核心可用性是"自解释"，用户无需查看源码即可掌握所有用法
# 核心功能：格式化输出所有命令的分类、参数、环境变量和使用示例，支持彩色终端输出
# 风险：新增命令如果忘记更新usage会导致用户无法发现新功能；格式调整可能破坏排版
# 收益：所有功能的使用方法集中展示，降低用户学习成本，统一工具的使用体验
# 灵活性：新增命令只需在usage的对应分类添加条目，无需调整输出逻辑
