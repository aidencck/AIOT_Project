# ======================================================================
# 入口分发：所有命令的总调度器，将用户输入的子命令转发给对应的处理函数
# 第一性原理：CLI的命令路由必须中心化，所有命令的注册和转发逻辑统一，避免路由分散导致的命令找不到问题
# 核心功能：如果用户没有输入任何子命令则输出usage，否则解析第一个参数作为子命令，匹配case中的命令列表，转发给对应的cmd_xxx函数处理，不识别的命令输出错误提示
# 风险：新增命令忘记添加到case列表会导致用户无法调用；命令名冲突会导致路由错误
# 收益：所有命令的路由逻辑集中在一个地方，新增命令只需在case中添加一行，路由逻辑清晰易维护，命令注册的成本降低90%
# 灵活性：支持新增任意类型的命令，只需添加对应的cmd_xxx函数和case条目，自动支持参数透传，扩展性极强
# ======================================================================
if (( $# == 0 )); then usage; exit 0; fi
sub="$1"; shift || true
case "$sub" in
  -h|--help|help) usage; exit 0 ;;
  infra|dev|local|admin|ci) "cmd_${sub}" "$@" ;;
  build|deploy|migrate|canary|rollback|gate|artifact-check) "cmd_${sub}" "$@" ;;
  reset) "cmd_${sub}" "$@" ;;
  doctor|verify|logs|ps|down|release-health) "cmd_${sub}" "$@" ;;
  log-query) cmd_log-query "$@" ;;
  test|drill|ai|observability|jvm-diagnostics|docker-ops) "cmd_${sub}" "$@" ;;
  *) log::fatal "unknown command: $sub  (see ./aiotctl help)" ;;
esac
