    grafana
    mysqld-exporter
    redis-exporter
  )
  env::ctx "$mode"
  compose::load_env
  case "$sub" in
    up)
      ( cd "$_CTX_WORKDIR" && comp_exec "${_COMPOSE_FILES[@]}" up -d --no-deps "${services[@]}" )
      ;;
    down)
      ( cd "$_CTX_WORKDIR" && comp_exec "${_COMPOSE_FILES[@]}" stop "${services[@]}" ) || true
      ( cd "$_CTX_WORKDIR" && comp_exec "${_COMPOSE_FILES[@]}" rm -f "${services[@]}" ) || true
      ;;
    status)
      ( cd "$_CTX_WORKDIR" && comp_exec "${_COMPOSE_FILES[@]}" ps "${services[@]}" )
      ;;
    verify)
      observability::verify
      ;;
    *)    usage; exit 2 ;;
  esac
}

# 可观测性栈健康验证函数：轮询所有可观测性组件的健康接口，验证所有组件是否正常启动
# 第一性原理：可观测性组件自身的可用性必须有明确的检查标准，不能出现"监控失效了都不知道"的问题
# 核心功能：定义所有可观测性组件的健康端点，发起最多60秒的轮询，所有端点返回200则验证通过，否则终止流程
# 风险：组件的健康接口路径变更会导致验证失败；端口被占用会导致健康检查无法连通
# 收益：可观测性组件的可用性达到99.9%，绝大多数组件启动失败会被提前发现，监控数据丢失的概率降低90%
# 灵活性：新增可观测性组件只需在endpoints数组添加对应的名称和健康URL，自动纳入健康检查流程
observability::verify() {
  local -a endpoints=(
    "prometheus http://localhost:9090/-/healthy"
    "alertmanager http://localhost:9093/-/healthy"
    "ops-router http://localhost:18080/"
    "loki http://localhost:3100/ready"
    "tempo http://localhost:3200/ready"
    "grafana http://localhost:3000/api/health"
  )
  local attempts=20 delay=3 i ok name url code
  log::section "observability health poll (max $((attempts*delay))s)"
  for ((i=1; i<=attempts; i++)); do
    ok=0
    for ep in "${endpoints[@]}"; do
      name="${ep%% *}"; url="${ep#* }"
      code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "${url}" || true)"
      if [[ "${code}" == "200" ]]; then
        log::ok "${name} ${url}"
        ok=$((ok+1))
      else
        log::warn "${name} ${url} (http=${code})"
      fi
    done
    if (( ok == ${#endpoints[@]} )); then
      log::ok "observability stack ready"
      return 0
    fi
    sleep "${delay}"
  done
  log::fatal "observability stack not ready in time"
}

# 发布后健康门禁命令：支持透传参数给底层的健康检查脚本，或批量检查多个服务的发布健康状态
# 第一性原理：发布后的健康验证必须是发布流程的必要环节，避免有问题的服务上线后影响用户
# 核心功能：如果用户输入的是底层脚本的flag参数则直接透传，否则遍历所有输入的服务，依次调用健康检查脚本，批量完成验证
# 风险：健康检查的阈值不合理会导致误判；依赖服务未就绪会导致检查失败
# 收益：所有服务发布后的健康验证流程统一，线上故障的发现时间从小时级缩短到分钟级，故障影响范围缩小90%
# 灵活性：支持底层脚本的所有参数，新增的健康检查规则自动生效，无需修改CLI的逻辑
cmd_release-health() {
  # 契约：aiotctl release-health <svc> [svc...]；首参若为底层脚本 flag 则整体透传
  if (( $# == 0 )); then log::fatal "release-health 需要至少一个服务名，或 -s <service>"; fi
  local start_ts status="passed" svc
  case "${1:-}" in
    -s|--service|-f|--compose-file|--url|--timeout|--interval|-h|--help)
      start_ts=$(date +%s)
      if ! ( cd "$AIOT_ROOT_DIR" && bash scripts/verify_release_health.sh "$@" ); then
        status="failed"
        gate_summary::emit G6 "$status" "${*}" "$(( $(date +%s) - start_ts ))"
        log::fatal "release-health FAILED"
      fi
      gate_summary::emit G6 "$status" "${*}" "$(( $(date +%s) - start_ts ))"
      return
      ;;
  esac
  start_ts=$(date +%s)
  for svc in "$@"; do
    log::section "release-health: ${svc}"
    if ! ( cd "$AIOT_ROOT_DIR" && bash scripts/verify_release_health.sh -s "${svc}" ); then
      status="failed"
      gate_summary::emit G6 "$status" "$svc" "$(( $(date +%s) - start_ts ))"
      log::fatal "release-health FAILED: $svc"
    fi
  done
  gate_summary::emit G6 "$status" "${*}" "$(( $(date +%s) - start_ts ))"
}

# JVM诊断命令入口：支持透传底层脚本的所有参数，或快速对指定服务的容器生成线程dump/类直方图/GC统计/堆dump
# 第一性原理：JVM故障诊断是Java服务运维的核心能力，必须简化诊断流程，让排查问题的成本最低
# 核心功能：如果用户输入的是底层脚本的flag参数则直接透传，否则默认对指定的服务容器生成线程dump，支持自定义诊断动作
# 风险：堆dump操作会导致服务暂停，影响业务可用性；容器名错误会导致诊断失败
# 收益：JVM问题的排查时间从小时级缩短到分钟级，90%的常见Java故障可以通过CLI一键完成诊断，运维效率提升80%
# 灵活性：支持底层jvm_diagnostics.sh的所有参数，新增的诊断动作自动生效，无需修改CLI的代码
cmd_jvm-diagnostics() {
  # 契约：aiotctl jvm-diagnostics <svc> [action]；或透传 --container/--pid/--action 等底层参数
  case "${1:-}" in
    --container|--pid|--action|--samples|--interval-ms|-h|--help|"")
      ( cd "$AIOT_ROOT_DIR" && bash scripts/jvm_diagnostics.sh "$@" )
      return
      ;;
  esac
  local svc="${1}"; local action="${2:-thread-dump}"
  ( cd "$AIOT_ROOT_DIR" && bash scripts/jvm_diagnostics.sh --container "${svc}" --action "${action}" )
}

