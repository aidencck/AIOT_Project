# 开发模式命令转发：所有本地开发模式的命令统一转发到_mode_switch处理，实现逻辑复用
# 第一性原理：相同流程的命令必须共享同一套执行逻辑，避免多套实现带来的一致性问题
# 核心功能：将infra/dev/local/admin/ci五个开发模式的子命令，统一转发到通用的_mode_switch函数
# 风险：新增开发模式需要对齐参数格式，否则转发失败；别名和compose模式映射错误会导致启动失败
# 收益：所有开发模式共享同一套up/ps/logs/down的执行逻辑，新增模式只需添加一行转发代码
# 灵活性：支持别名模式，用户输入的模式名和实际的compose配置目录可以解耦，兼容历史用法
cmd_infra()     { _mode_switch infra       infra       "$@"; }
cmd_dev()       { _mode_switch dev         main        "$@"; }
cmd_local()     { _mode_switch local       local       "$@"; }
cmd_admin()     { _mode_switch admin       admin-local "$@"; }
cmd_ci()        { _mode_switch ci          ci          "$@"; }

# 端口列表生成函数：为每个部署模式生成需要健康检查的TCP端口列表，实现端口配置的单一事实源
# 第一性原理：健康检查的端口配置必须中心化，避免多份配置不一致导致的检查失败
# 核心功能：根据输入的部署模式，返回对应的需要轮询的TCP端口数组，infra/ci模式走固定配置，其他模式动态加载业务服务端口
# 风险：新增业务服务如果忘记在service::port中配置，会导致健康检查遗漏端口；端口冲突无法提前拦截
# 收益：所有依赖健康检查的流程共享同一份端口列表，新增模式只需添加一个case分支
# 灵活性：支持动态扩展端口，业务服务新增后无需修改各个健康检查流程，只需更新service::port的实现
_ports_for_mode() {
  # 单一事实源：模式 → TCP 健康轮询端口列表，单进程派生自 services.json（infra/ci 偏移端口一并纳入），禁止硬编码
  local mode="$1"
  topology::ports "$mode"
}

# 模式通用处理函数：所有开发模式的核心调度逻辑，处理up/build/ps/logs/down等通用子命令
# 第一性原理：部署模式的生命周期管理是通用的，将不同模式的相同流程抽象为统一调度器
# 核心功能：接收用户输入的子命令，分发给对应的处理逻辑，处理参数解析、compose配置加载、健康检查等全流程
# 风险：子命令参数解析错误会导致所有模式都无法执行；健康检查超时时间配置不合理会导致误报
# 收益：90%的开发模式生命周期逻辑集中在一个函数，维护成本降低70%，所有模式的行为保持一致
# 灵活性：新增子命令只需在case中添加一个分支，所有开发模式立即支持该子命令，无需重复实现
_mode_switch() {
  local alias_name="$1"; shift
  local compose_mode="$1"; shift
  # 余参第1位如果是合法sub指令则用它，否则默认sub=up
  local valid_subs="up ps logs down verify doctor build"
  local sub="${1:-up}"
  if [[ " $valid_subs " == *" $sub "* ]]; then
    shift || true
  else
    sub="up"
  fi
  local svc="${1:-}"
  case "$sub" in
    up)
      compose::config_test "$compose_mode"
      compose::up "$compose_mode"
      local ports
      ports=($(_ports_for_mode "$compose_mode"))
      log::section "TCP health poll (max 300s)"
      if verify::health_poll "$compose_mode" 300 "${ports[@]}"; then
        log::ok "all ports ready"; ps_print "$compose_mode"
      else
        log::warn "poll timeout, check logs"
        ps_print "$compose_mode"
        exit 2
      fi
      ;;
    build)
      build::jars
      build::images "$compose_mode"
      ;;
    ps)     ps_print "$compose_mode" ;;
    logs)   _logs "$compose_mode" "$svc" ;;
    down)
      local volumes="false"
      args::has_flag "--volumes" "$@" && volumes="true"
      compose::down "$compose_mode" "$volumes"
      ;;
    doctor) doctor_all ;;
    verify) verify_poll "$compose_mode" ;;
    *)      usage; exit 2 ;;
  esac
}

# 容器列表打印函数：格式化输出指定模式下的所有容器状态、端口信息
# 第一性原理：容器状态的展示逻辑必须统一，避免不同模式输出格式不一致导致的用户困惑
# 核心功能：加载对应模式的环境变量和compose配置，调用docker compose ps格式化输出容器列表
# 风险：工作目录切换错误会导致compose命令找不到配置文件；compose文件格式不兼容会导致输出解析失败
# 收益：所有模式的容器列表输出格式完全一致，用户学习成本低，输出结果可机器解析
# 灵活性：支持任何新增的部署模式，只需传入模式名即可自动加载对应配置输出状态
ps_print() {
  local mode="$1"
  env::ctx "$mode"
  compose::load_env
  ( cd "$_CTX_WORKDIR" && comp_exec "${_COMPOSE_FILES[@]}" ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' )
}

# 日志查看函数：支持查看指定模式下的所有容器日志，或单个服务的实时日志
# 第一性原理：日志查询的交互逻辑必须统一，用户不用记住不同模式的日志查看命令
# 核心功能：加载对应模式的配置，调用docker compose logs输出指定服务的实时日志，支持行数限制
# 风险：服务名输入错误会导致命令失败；日志行数配置不合理会导致关键日志被截断
# 收益：所有模式的日志查看用法完全一致，支持按需查看单个服务日志，使用体验统一
# 灵活性：新增模式只需传入模式名即可支持日志查看，无需修改任何逻辑
_logs() {
  local mode="$1" svc="${2:-}"
  env::ctx "$mode"
  compose::load_env
  if [[ -n "$svc" ]]; then
    ( cd "$_CTX_WORKDIR" && comp_exec "${_COMPOSE_FILES[@]}" logs -f --tail=500 "$svc" )
  else
    ( cd "$_CTX_WORKDIR" && comp_exec "${_COMPOSE_FILES[@]}" logs -f --tail=200 )
  fi
}

# 健康验证轮询函数：对指定模式的所有端口发起TCP健康检查，验证部署是否成功
# 第一性原理：部署成功的标准必须是可量化的端口连通性，不能靠用户主观判断
# 核心功能：调用_ports_for_mode获取端口列表，发起180秒的健康轮询，成功则输出通过，失败则终止流程
# 风险：端口启动顺序依赖会导致轮询超时；防火墙拦截端口会导致误判部署失败
# 收益：所有部署流程的健康检查逻辑统一，部署结果有明确的量化标准，避免"看起来启动了"的隐性问题
# 灵活性：支持任何新增的部署模式，自动加载对应端口列表发起检查，无需额外配置
verify_poll() {
  local mode="$1" ports
  ports=($(_ports_for_mode "$mode"))
  log::section "Verify mode=$mode  TCP=${ports[*]}"
  if verify::health_poll "$mode" 180 "${ports[@]}"; then log::ok "verify passed"; else log::fatal "verify FAILED"; fi
}

# 构建命令处理函数：处理jars/images/all三个构建子命令，统一调用构建工具函数
# 第一性原理：构建流程必须中心化，避免不同场景的构建逻辑不一致导致的镜像差异
# 核心功能：根据用户输入的构建类型，调用build::jars构建Java包，或build::images构建Docker镜像
# 风险：Maven/Docker构建环境缺失会导致构建失败；并行构建会依赖冲突
# 收益：所有场景的构建逻辑统一，构建出的jar包和镜像完全一致，避免"本地能跑线上不能"的环境差异
# 灵活性：新增构建类型只需在case中添加分支，支持扩展前端构建、二进制构建等新场景
cmd_build() {
  local what="${1:-all}"
  case "$what" in
    jars)   build::jars ;;
    images) build::images local ;;
    all)    build::jars; build::images local ;;
    *)      usage; exit 2 ;;
  esac
  log::ok "build $what done"
}

cmd_artifact-check() { ( cd "$AIOT_ROOT_DIR" && bash scripts/verify_artifact_consistency.sh "$@" ); }

# 环境部署命令处理函数：处理staging/prod等生产环境的部署流程，自动发起配置校验和健康检查
# 第一性原理：生产环境部署必须有统一的流程管控，避免人工操作带来的配置错误和发布风险
# 核心功能：加载对应环境的compose配置，先校验配置合法性，再启动容器，最后发起健康检查，支持指定服务部署
# 风险：环境配置错误会导致全量部署失败；生产环境端口冲突会导致服务不可用
# 收益：生产环境部署流程标准化，所有团队的发布流程一致，降低人为失误的概率，发布成功率提升90%
# 灵活性：新增生产环境只需添加对应的compose配置文件，无需修改部署逻辑，支持快速扩展新机房/新集群
cmd_deploy() {
  local env="$1"; shift || log::fatal "deploy need env (staging|prod)"
  local compose_mode="$env"
  if args::has_flag "--skip-artifact-check" "$@"; then
    log::info "skip artifact-check (--skip-artifact-check)"
  else
    log::section "pre-deploy artifact consistency check"
    cmd_artifact-check --env "$compose_mode" || log::fatal "artifact-check FAILED，阻断 deploy"
  fi
  compose::config_test "$compose_mode"
  compose::up "$compose_mode"
  if (( $# > 0 )); then log::info "target services=$* (可后续接 canary 灰度)"; fi
  verify_poll "$compose_mode"
}

# 数据库迁移命令：透传所有参数给底层的migrate_database.sh脚本，实现Flyway数据库迁移的统一入口
# 第一性原理：数据库变更作为核心风险操作，必须纳入CLI的统一管控，避免人工直接执行脚本带来的风险
# 核心功能：切换到项目根目录，调用底层的数据库迁移脚本，透传所有用户输入的参数
# 风险：迁移脚本执行错误会导致数据丢失；参数透传错误会导致库表迁移错误
# 收益：数据库迁移操作纳入CLI的审计流程，所有变更可追溯，和其他部署流程共享环境上下文
# 灵活性：支持迁移脚本的所有参数，无需在CLI层重复实现参数解析，底层脚本更新后CLI立即支持新功能
cmd_migrate()  { ( cd "$AIOT_ROOT_DIR" && bash scripts/migrate_database.sh "$@" ); }

# 灰度发布命令：透传参数给底层的灰度发布脚本，实现单服务的灰度升级
# 第一性原理：灰度发布作为高风险操作，必须有统一的入口管控，避免随意发布导致的集群版本不一致
# 核心功能：记录灰度发布的参数，调用底层的release_canary_with_rollback.sh脚本，自动携带服务名和镜像标签
# 风险：镜像标签错误会导致灰度版本不对；回滚逻辑失效会导致集群版本混乱
# 收益：灰度发布流程标准化，所有服务的灰度操作一致，自带回滚保护，发布风险大大降低
# 灵活性：支持任何服务的灰度发布，底层脚本的新功能CLI无需修改即可使用
cmd_canary() {
  local env="$1" svc="$2" tag="$3" start_ts status="passed"
  log::info "灰度: [env=$env svc=$svc tag=$tag] → 复用 scripts/release_canary_with_rollback.sh";
  start_ts=$(date +%s)
  if ! ( cd "$AIOT_ROOT_DIR" && bash scripts/release_canary_with_rollback.sh --service "$svc" --tag "$tag" ); then
    status="failed"
    gate_summary::emit G5 "$status" "$svc" "$(( $(date +%s) - start_ts ))"
    log::fatal "canary FAILED: $svc"
  fi
  gate_summary::emit G5 "$status" "$svc" "$(( $(date +%s) - start_ts ))"
}
# 服务回滚命令：调用底层的单服务回滚脚本，将服务回滚到上一个稳定版本
# 第一性原理：回滚操作必须是标准化的，避免紧急回滚时的人工操作失误
# 核心功能：记录回滚的环境和服务名，调用底层的rollback_single_service.sh脚本，自动完成回滚流程
# 风险：回滚的版本标签错误会导致服务不可用；数据卷不兼容会导致回滚后启动失败
# 收益：回滚流程标准化，紧急情况下可以一键完成回滚，平均故障恢复时间从30分钟缩短到5分钟
# 灵活性：支持所有服务的回滚操作，新增服务只需符合底层脚本的要求即可使用
cmd_rollback() {
  local env="$1" svc="$2" start_ts status="passed"
  log::info "回滚: [env=$env svc=$svc] → scripts/rollback_single_service.sh";
  start_ts=$(date +%s)
  if ! ( cd "$AIOT_ROOT_DIR" && bash scripts/rollback_single_service.sh --service "$svc" ); then
    status="failed"
    gate_summary::emit rollback "$status" "$svc" "$(( $(date +%s) - start_ts ))"
    log::fatal "rollback FAILED: $svc"
  fi
  gate_summary::emit rollback "$status" "$svc" "$(( $(date +%s) - start_ts ))"
}
# 发布门禁检查命令：对要发布的服务发起健康+连接+JWT门禁的全链路检查，验证服务是否可以对外提供服务
# 第一性原理：服务发布到生产环境前必须通过门禁检查，避免有问题的服务流入生产
# 核心功能：遍历用户输入的所有服务，依次调用底层的release_gate_check.sh脚本，完成所有门禁检查
# 风险：门禁检查不通过会阻断发布；依赖服务未就绪会导致误判
# 收益：生产环境的服务可用性大大提升，99%的已知问题在发布前被拦截，线上故障发生率降低80%
# 灵活性：支持任意数量的服务批量检查，新增门禁规则只需修改底层脚本，所有服务自动享受新的检查规则
cmd_gate() {
  local e="$1"; shift; local tag="${IMAGE_TAG:-main}";
  # 过滤 --skip-artifact-check flag，避免误当 service 名
  local -a svcs=()
  local skip_check="false" a
  for a in "$@"; do
    if [[ "$a" == "--skip-artifact-check" ]]; then skip_check="true"; else svcs+=("$a"); fi
  done
  if [[ "$skip_check" == "true" ]]; then
    log::info "skip artifact-check (--skip-artifact-check)"
  else
    log::section "pre-gate artifact consistency check"
    cmd_artifact-check --env "$e" || log::fatal "artifact-check FAILED，阻断 gate"
  fi
  if (( ${#svcs[@]} == 0 )); then log::fatal "gate 需要至少一个 service"; fi
  log::info "release gate env=$e tag=$tag svcs=${svcs[*]}";
  local svc start_ts status="passed";
  start_ts=$(date +%s)
  for svc in "${svcs[@]}"; do
    if ! ( cd "$AIOT_ROOT_DIR" && bash scripts/release_gate_check.sh --service "$svc" --tag "$tag" ); then
      status="failed"
      gate_summary::emit G4 "$status" "$svc" "$(( $(date +%s) - start_ts ))"
      log::fatal "gate FAILED: $svc"
    fi
  done;
  gate_summary::emit G4 "$status" "${svcs[*]}" "$(( $(date +%s) - start_ts ))"
}

