# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Build tools
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE files
.idea/
*.iml
*.iws
.project
.classpath
.settings/
.vscode/

# Environment / Data
data/
data/mysql/
data/redis/

# Test artifacts (may contain real credentials/JWT from local test runs)
artifacts/

# Runtime progress snapshot (regenerated by scripts/gen_status_snapshot.sh)
.trae/status_snapshot.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# PID files
*.pid

# Docker Compose env files
.env
compose/env/*/runtime.env
compose/env/*/.env
!compose/env/*/.env.example

# Frontend modules
aiot-admin-web/node_modules/
aiot-admin-web/dist/

# Node.js tooling (root: commitlint + semantic-release)
node_modules/

# Python build cache / package metadata
__pycache__/
*.pyc
*.egg-info/

# IDE run configurations
.run/

# Local debug notes
debug-*.md

# Release state snapshots (regenerated by release pipeline)
scripts/.release_state/
