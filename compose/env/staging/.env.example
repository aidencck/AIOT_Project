# === staging 环境变量样例：预发布联调 / 回归验证 ===
AIOT_ENV=staging
SPRING_PROFILES_ACTIVE=staging
IMAGE_TAG=staging
AIOT_OPENAPI_PUBLIC_ENABLED=false

# === 部署前复制为 runtime.env 并填入 ===
# 生成强密码建议：openssl rand -hex 16
MYSQL_PASSWORD=
EMQX_API_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
AIOT_JWT_SECRET=
AIOT_INTERNAL_TOKEN=
AIOT_EMQX_WEBHOOK_SECRET=
# EMQX 设备上下线 Webhook 目标 URL（容器内通过服务名访问 aiot-auth-service）
AUTH_WEBHOOK_URL=http://aiot-auth-service:8082/api/v1/emqx/webhook

# === AI 诊断 LLM（Ollama，OpenAI-compatible；以下均为可选，compose 内置默认值）===
# OLLAMA_MODEL=qwen2.5:1.5b
# AI_LLM_ENABLED=true
# AI_LLM_BASE_URL=http://ollama:11434
# AI_LLM_API_KEY=ollama
# AI_LLM_MODEL=qwen2.5:1.5b
# 推理延迟优化：限制输出 token 数与上下文窗口（num_predict/num_ctx 透传 Ollama options）
# AI_LLM_NUM_PREDICT=512
# AI_LLM_NUM_CTX=2048
# AI_LLM_TIMEOUT_MS=20000
